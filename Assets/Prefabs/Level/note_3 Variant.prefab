--- !u!1001 &5552757127606826547
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 3029950099273771978, guid: ae5ae7c3ff1008f4c936a40c9bbedd02, type: 3}
      propertyPath: m_text
      value: "I thought we were drifting quietly. Guess not. Black Drift scout ship,
        must\u2019ve picked us up weeks ago. They're crawling the ship now. I\u2019ve
        sealed myself in the ventilation shaft 4.\r\n\r\nOne month left on your timer,
        pod's still intact.\r\n\r\nThey searched the ship, but didn\u2019t touch
        you. Heard one say, \u201Cthat one\u2019s Coalition-marked \u2014 trouble
        if alive, trash if not.\u201D They figured you'd never make it with half
        our systems dark. Said they\u2019ll strip what they want and let us drift.\r\n\r\nI
        think they\u2019re setting up something permanent here. One of them said
        the name of their station: \nVael"
      objectReference: {fileID: 0}
    - target: {fileID: 8495083335092659354, guid: ae5ae7c3ff1008f4c936a40c9bbedd02, type: 3}
      propertyPath: m_Name
      value: note_3 Variant
      objectReference: {fileID: 0}
