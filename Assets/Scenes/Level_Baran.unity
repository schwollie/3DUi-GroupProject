  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Systems stable. Drive coil humming. Black Drift tech \u2014 purged.\nThe
    console lights up, one green status bar at a time.\n\nOne name blinks on the
    nav console:\nTheta\u20117. Still far. Still waiting.\n\nYou never found them
    \u2014 whoever wrote the logs.\nBut you carried the mission forward. One spark.
    One breath at a time.\n\nYou sit back. Let the hum of the engines fill the silence.\nAnd
    for the first time in years, you sleep by choice."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
